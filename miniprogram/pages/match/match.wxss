/* pages/match/match.wxss */
.container {
  padding: 10px;
}

/* 队伍区域 */
.team-section {
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 10px;
  color: white;
}

.team-a { 
  background-color: #ff7675; 
}

.team-b { 
  background-color: #74b9ff; 
}

.team-title {
  font-weight: bold;
  margin-bottom: 15px;
  text-align: center;
  font-size: 36rpx;
}

/* 球员选择器 */
.player-selector {
  margin-bottom: 10px;
}

.selected-player {
  background: rgba(255, 255, 255, 0.3);
  padding: 10px;
  text-align: center;
  border-radius: 5px;
  font-size: 28rpx;
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-player:active {
  background: rgba(255, 255, 255, 0.5);
}

/* 比分输入 */
.score-input {
  background: white;
  color: #333;
  height: 40px;
  text-align: center;
  font-size: 20px;
  border-radius: 5px;
  margin-top: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-input input {
  height: 100%;
  text-align: center;
  font-size: 20px;
  width: 100%;
}

/* VS 分隔 */
.vs-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0;
}

.vs {
  text-align: center;
  font-weight: bold;
  font-size: 24px;
  color: #888;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 20px;
  width: 100% !important;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8px;
  height: 45px;
  font-size: 32rpx;
  font-weight: bold;
}

.submit-btn:active {
  opacity: 0.85;
}

/* 🌟 弹窗样式 */
.player-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  width: 85%;
  max-height: 75vh;
  background: #fff;
  border-radius: 15px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}

.modal-close:active {
  opacity: 1;
}

/* 搜索框 */
.search-box {
  padding: 15px 20px;
  background: #f8f9fa;
  border-bottom: 1px solid #e9ecef;
}

.search-input {
  height: 40px;
  padding: 0 15px;
  background: white;
  border-radius: 20px;
  font-size: 28rpx;
  border: 1px solid #dee2e6;
}

/* 🌟 球员列表 - 直接点击选中 */
.player-list {
  flex: 1;
  max-height: 55vh;
  background: white;
}

.player-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 55px;
  padding: 0 20px;
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.2s;
}

.player-item:active {
  background: #667eea;
  color: white;
}

/* 🌟 当前已选样式 */
.player-item.current-selected {
  background: #e7f3ff;
  border-left: 4px solid #667eea;
}

.player-name {
  font-size: 30rpx;
  color: #333;
}

/* 🌟 当前标签 */
.current-tag {
  font-size: 24rpx;
  color: #667eea;
  padding: 2px 8px;
  background: #e7f3ff;
  border-radius: 10px;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
/* 🔐 密码验证样式 */
.password-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.password-container {
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
}

.password-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.password-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.password-buttons {
  display: flex;
  gap: 24rpx;
}

.password-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.password-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.password-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

/* 快捷比分按钮 */
.quick-scores {
  background: white;
  border-radius: 12px;
  padding: 12px 15px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.quick-scores-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10px;
}

.quick-score-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.quick-score-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
}

.quick-score-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 搭档推荐 */
.partner-recommend {
  margin-top: 10px;
  padding: 8px 10px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8px;
}

.recommend-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 6px;
}

.recommend-tag {
  background: rgba(255, 255, 255, 0.9);
  color: #667eea;
  padding: 4px 12px;
  border-radius: 15px;
  font-size: 24rpx;
  font-weight: 500;
}

.recommend-tag:active {
  background: white;
  transform: scale(0.95);
}