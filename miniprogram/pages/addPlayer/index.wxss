/* pages/index/index.wxss */
.container {
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
  color: #333;
}

.input-box {
  width: 100%;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px;
  margin-bottom: 20px;
  box-sizing: border-box; /* 防止padding撑大宽度 */
}

input {
  height: 40px;
  font-size: 16px;
}

button {
  width: 100% !important; /* 强制占满 */
}

/* 🔐 密码验证样式 */
.password-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.password-container {
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
}

.password-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 16rpx;
  color: #333;
}

.password-hint {
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 40rpx;
  color: #999;
}

.password-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.password-buttons {
  display: flex;
  gap: 24rpx;
}

.password-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.password-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.password-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

/* 调试按钮 */
.debug-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 200rpx;
  height: 60rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #999;
  opacity: 0.3;
}